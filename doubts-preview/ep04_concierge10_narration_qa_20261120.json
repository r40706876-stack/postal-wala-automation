  "script": [
    [
      "h1",
      "जॉइनिंग या कटऑफ? पहले ये ज़रूरी नियम सेव कर लो।"
    ],
    [
      "q1",
      "डाक विभाग के डाउट्स, भाग चार।"
    ],
    [
      "z0",
      "दो तारीखों का फर्क समझो।"
    ],
    [
      "z1",
      "आंध्र परिमंडल की दो हज़ार छब्बीस एमटीएस अधिसूचना: तीन साल की नियमित जीडीएस एंगेजमेंट, एक जनवरी तक।"
    ],
    [
      "z2",
      "उदाहरण: जॉइनिंग उन्नीस फ़रवरी दो हज़ार तेईस। तीन साल पूरे, उन्नीस फ़रवरी दो हज़ार छब्बीस को।"
    ],
    [
      "z3",
      "पर कटऑफ एक जनवरी थी। उस दिन तीन साल पूरे नहीं थे। बाद में पूरे होने से यह शर्त पूरी नहीं होती।"
    ],
    [
      "z4",
      "जॉइनिंग से अवधि गिनो। कटऑफ पर जाँचो। बाकी पात्रता शर्तें भी देखो।"
    ],
    [
      "o1",
      "परीक्षा की तारीख को कटऑफ मत समझ लेना।"
    ],
    [
      "d1",
      "जवाब सी: कटऑफ तारीख। अगली परीक्षा की नई अधिसूचना ही मानें।"
    ],
    [
      "m1",
      "अगला डाउट: सिर्फ़ एमटीएस के लिए स्थानीय भाषा पेपर? रोज़ शाम साढ़े छह बजे, पोस्टल वाला से जुड़ें।"
    ]
  ],
